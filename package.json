{
  "name": "nexus-crm-saas",
  "private": true,
  "version": "6.50.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "cd tests/e2e && npx playwright test",
    "test:e2e:headed": "cd tests/e2e && npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report playwright-report",
    "test:unit": "vitest run",
    "test:backend": "cd backend && source venv/bin/activate && python -m pytest",
    "test:backend:rag": "cd backend && source venv/bin/activate && python -m pytest tests/test_rag.py -v",
    "test:backend:rls": "cd backend && source venv/bin/activate && python -m pytest tests/test_rls.py -v",
    "test:backend:integrations": "cd backend && source venv/bin/activate && python -m pytest tests/test_integrations.py -v",
    "load-test": "cd backend && source venv/bin/activate && python scripts/load_test.py",
    "outage-drill": "cd backend && source venv/bin/activate && python scripts/outage_drill.py",
    "prebuild": "mkdir -p public/vendor && cp -f node_modules/@techstark/opencv-js/dist/opencv.js public/vendor/opencv.js",
    "predev": "mkdir -p public/vendor && cp -f node_modules/@techstark/opencv-js/dist/opencv.js public/vendor/opencv.js"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-character-count": "^2.27.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-dropcursor": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/suggestion": "^2.27.2",
    "i18next": "^26.3.6",
    "lucide-react": "^1.25.0",
    "moment": "^2.30.1",
    "react": "^19.2.7",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.2.7",
    "react-dropzone": "^20.1.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tippy.js": "^6.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.0"
  }
}
